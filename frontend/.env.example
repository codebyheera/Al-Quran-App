# Copy this to .env.local and fill in your values
# In production, set this in Vercel's Environment Variables dashboard

VITE_API_URL=https://your-backend.vercel.app

# Optional — overrides the Supabase project URL used for the Urdu audio
# fallback (lib/audioSource.js). Defaults to the production project if unset.
VITE_SUPABASE_URL=https://hjuaeuelhwnjomagnmtx.supabase.co

# Optional — Sentry error monitoring (lib/sentry.js). Sentry → Project Settings
# → Client Keys (DSN). Only active in production builds; unset = disabled.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# Optional — build-time only (vite.config.js): uploads source maps to Sentry
# so errors show the real file/line. Sentry → Settings → Auth Tokens →
# Organization Token. Set it in Vercel only (as a Secret); never commit it.
# SENTRY_AUTH_TOKEN=sntrys_...
