# Backend Environment Variables
PORT=5000

# Supabase PostgreSQL — Direct Connection String
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hjuaeuelhwnjomagnmtx.supabase.co:5432/postgres

# Groq API key for the /api/chat chatbot (and any future AI text feature
# that goes through lib/groqClient.js). Get one at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# Optional — a second Groq key/project. If a request on the primary key
# fails (rate limit, quota, auth, transient 5xx), it's retried once here.
# GROQ_API_KEY_BACKUP=your-backup-groq-api-key
# Optional — defaults to openai/gpt-oss-120b if unset. Groq's model lineup
# changes over time; check what your key has access to with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — web-search-capable model used ONLY when nothing relevant is
# found on the site itself. Defaults to groq/compound-mini.
# GROQ_WEB_SEARCH_MODEL=groq/compound-mini

# Supabase project URL and keys — used by scripts/upload-urdu-audio.js
# (and any other script that talks to Supabase Storage/DB directly).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-key
# Service role key (Project Settings -> API). Required for
# scripts/upload-urdu-audio.js so it can create the storage bucket and
# upload files regardless of bucket RLS policies. Keep this secret —
# never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
